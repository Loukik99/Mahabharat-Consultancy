# Copy to .env and fill in. For local dev you can leave MONGODB_URI blank to
# auto-start an in-memory MongoDB (no install required).

PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS (comma-separated).
# REQUIRED in production — server refuses to start if unset.
CLIENT_URL=http://localhost:5173,http://localhost:5180

# Optional: exact Vercel preview origins to allow (comma-separated full URLs).
# Never rely on a blanket *.vercel.app allowlist.
# VERCEL_PREVIEW_ORIGINS=https://your-preview-abc123.vercel.app

# Leave blank for an auto in-memory DB in dev, or set your MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mahabharat
MONGODB_URI=

# Auth — REQUIRED in production (≥32 random chars). Server fails closed if missing/weak.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# After rotating away from any previously exposed/fallback secret, set:
# JWT_SECRET_ROTATED=true
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=mc_auth
# CSRF_COOKIE_NAME=mc_csrf

# File uploads
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail SMTP) — welcome + password-reset OTP.
# EMAIL_PASS must be a Gmail APP PASSWORD, not the normal account password.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Mahabharat Consultancy

CALL_PROVIDER=stub
